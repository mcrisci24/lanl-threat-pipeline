# --- Secrets ---
# The project spec explicitly says: do not commit AWS keys, Databricks tokens,
# database passwords, or API secrets. Leaked credentials force a resubmission.
.env
.env.*
*.pem
*.pfx
secrets/
credentials/
aws.json

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- Virtual envs ---
venv/
.venv/
env/
.python-version

# --- MLflow ---
mlruns/

# --- Model artifacts ---
# Tracked artifacts are regenerated by jobs/train_model.py. Don't commit
# the binary .joblib files - they're large and CI/CD should rebuild them.
model_outputs/**/*.joblib
model_outputs/**/mlruns/

# --- Spark/EMR scratch ---
spark-warehouse/
metastore_db/
derby.log
*.log

# --- LANL raw / processed data ---
# These are far too large for git. Keep the small sample CSVs for the
# offline verification path, but ignore everything else.
auth.txt.gz
flows.txt.gz
proc.txt.gz
dns.txt.gz
redteam.txt.gz
silver_outputs/*.parquet
silver_outputs/**/_SUCCESS
gold_outputs/*.parquet
gold_outputs/**/_SUCCESS
dq_reports/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
~$*
desktop.ini
